generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url      = env("MIRROR_DATABASE_URL")
}
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  sessionVersion Int      @default(0)
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  spending      Expense[]
  benchmarks    UserBenchmark[]
  subscription  Subscription?
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}
model Subscription {
  id        String  @id @default(cuid())
  userId    String  @unique
  plan      String  @default("free")
  isPremium Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Expense {
  id          String   @id @default(cuid())
  userId      String
  date        String
  amountCents Int
  description String
  category    String   @default("Other")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, date])
}
model Instrument {
  id          String   @id
  name        String
  currency    String
  isin        String?
  exchange    String
  type        String
  createdAt   DateTime @default(now())
  users UserBenchmark[]
}
model UserBenchmark {
  userId       String
  instrumentId String
  createdAt    DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id])
  @@id([userId, instrumentId])
}
model MarketCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())
}
model RateLimit {
  key       String   @id
  hits      Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model TrafficDay {
  day String
  path String
  views Int @default(0)
  visitors Int @default(0)
  @@id([day, path])
}
model TrafficVisitor {
  day String
  hash String
  expiresAt DateTime @db.Timestamptz
  @@id([day, hash])
  @@index([expiresAt])
}
